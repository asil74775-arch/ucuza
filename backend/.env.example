# --- Dengi.com Backend ortam değişkenleri ---
APP_ENV=production
SECRET_KEY=degistir-en-az-32-karakter-rastgele-anahtar
DATABASE_URL=postgresql+asyncpg://dengi:dengi@db:5432/dengi
REDIS_URL=redis://redis:6379/0
MEDIA_ROOT=/data/media
PUBLIC_BASE_URL=https://api.dengi.com

# Yasal metinlerde görünecek işletme bilgileri
OPERATOR_NAME=
OPERATOR_ADDRESS=
CONTACT_EMAIL=destek@dengi.com

# Google Gemini (ücretsiz katman: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Faturalandırma açık (ücretli katman) ise true yapın; açık rıza metni buna göre değişir
GEMINI_PAID_TIER=false

# Lisanslı veri kaynakları (resmi API / affiliate) — yalnızca ürün, fiyat ve puan alınır
AFFILIATE_FEED_URLS=
